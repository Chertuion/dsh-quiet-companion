{
  "name": "dsh-quiet-companion",
  "version": "0.4.1-beta.1",
  "description": "安静陪伴：橙发花饰桌面伙伴，跟随 Harness 默认模型的画面与视频陪伴、自适应发言、记忆、Agent 进度与零食成长。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "index.mjs",
    "client.js",
    "client",
    "lib",
    "cordis.patch.yml",
    "native/QuietCompanion.app",
    "third_party",
    "README.md",
    "README.txt",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CHANGELOG.md",
    "assets/orange-character/ASSET_SOURCE.md",
    "native/README.txt"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    }
  },
  "scripts": {
    "test": "node --test lib/*.test.mjs client/*.test.mjs client/*.test.cjs",
    "build:client": "node client/build.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/server-memory": "2.0.1",
    "@orama/orama": "3.1.18"
  }
}
